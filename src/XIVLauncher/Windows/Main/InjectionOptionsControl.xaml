<UserControl x:Class="XIVLauncher.Windows.Main.InjectionOptionsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignWidth="240" d:DesignHeight="480">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Windows/Main/LoginCardSlideResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <materialDesign:Card UniformCornerRadius="12"
                         materialDesign:ElevationAssist.Elevation="Dp4"
                         Padding="0">
        <!-- 行结构对着左边的登录卡片: 第一行与卡片顶部工具栏同高（标题落在那一层），
             中间行的内容从「当前账号」那一栏的高度开始, 状态行留在底部 -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="本次注入"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Margin="20,0,20,0"
                       VerticalAlignment="Center" />

            <!-- 上边距 = 登录卡片里「当前账号」栏距该行起点的距离 -->
            <StackPanel Grid.Row="1" Margin="20,71,20,0" VerticalAlignment="Top">
                <Grid Height="30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Dalamud" FontSize="13" VerticalAlignment="Center" />
                    <ToggleButton Grid.Column="1"
                                  x:Name="DalamudToggle"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                  IsChecked="{Binding InjectionOptions.WithDalamud}"
                                  ToolTip="本次启动是否随游戏注入 Dalamud">
                        <ToggleButton.LayoutTransform>
                            <ScaleTransform ScaleX="0.72" ScaleY="0.72" />
                        </ToggleButton.LayoutTransform>
                    </ToggleButton>
                </Grid>

                <Grid Height="30" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Minion" FontSize="13" VerticalAlignment="Center" />
                    <ToggleButton Grid.Column="1"
                                  x:Name="MinionToggle"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                  IsChecked="{Binding InjectionOptions.WithMinion}"
                                  ToolTip="本次启动是否在游戏起来后挂 MinionLauncher（密码和安装目录在设置里配置一次）">
                        <ToggleButton.LayoutTransform>
                            <ScaleTransform ScaleX="0.72" ScaleY="0.72" />
                        </ToggleButton.LayoutTransform>
                    </ToggleButton>
                </Grid>

                <StackPanel Margin="0,22,0,0"
                            IsEnabled="{Binding InjectionOptions.WithMinion}">
                    <TextBlock Text="分组" FontSize="11" Opacity="0.5" Margin="2,0,0,6" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ComboBox Grid.Column="0"
                                  x:Name="MinionGroupComboBox"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  materialDesign:TextFieldAssist.TextFieldCornerRadius="8"
                                  FontSize="12"
                                  Padding="10,6"
                                  ItemsSource="{Binding InjectionOptions.MinionGroups}"
                                  SelectedItem="{Binding InjectionOptions.SelectedMinionGroup}"
                                  DisplayMemberPath="DisplayName"
                                  ToolTip="本次启动用哪个 Minion 分组（每次现读 Minion 的 Settings\Accounts.json）" />

                        <Button Grid.Column="1"
                                Margin="8,0,0,0"
                                Style="{StaticResource HeaderUtilityButtonStyle}"
                                Width="26" Height="26"
                                ToolTip="重新读取分组与账号"
                                Command="{Binding InjectionOptions.RefreshMinionGroupsCommand}">
                            <materialDesign:PackIcon Kind="Refresh" Width="14" Height="14" />
                        </Button>
                    </Grid>

                    <TextBlock Text="Keycode" FontSize="11" Opacity="0.5" Margin="2,16,0,6" />

                    <ComboBox x:Name="MinionAccountComboBox"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              materialDesign:TextFieldAssist.TextFieldCornerRadius="8"
                              FontSize="12"
                              Padding="10,6"
                              Margin="0,0,34,0"
                              ItemsSource="{Binding InjectionOptions.MinionAccountsInGroup}"
                              SelectedItem="{Binding InjectionOptions.SelectedMinionAccount}"
                              ToolTip="本次启动用分组里的哪个账号（显示 Accounts.json 里的 Keycode）">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Keycode}"
                                           ToolTip="{Binding Keycode}"
                                           TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="2" Margin="20,0,20,18">
                <Separator Opacity="0.2" Margin="0,0,0,12" />
                <TextBlock Text="{Binding InjectionOptions.CrossDCStatusText}"
                           ToolTip="{Binding InjectionOptions.CrossDCStatusDetail}"
                           FontSize="11"
                           Opacity="0.6"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </materialDesign:Card>
</UserControl>
