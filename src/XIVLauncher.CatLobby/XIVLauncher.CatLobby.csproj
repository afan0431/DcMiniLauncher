<?xml version="1.0" encoding="utf-8"?>
<!--
  国际服 Dalamud 插件 CatLobby: 在游戏进程里开 \\.\pipe\minilauncher-<pid>, 按国服小模块（XIVLauncher.MiniModule）同一套协议
  应答「自动进入角色」的命令, 让 CatAutoEnter 对国际服原样复用。
  编译要引用国际服 Dalamud 的程序集: 默认取 DML 自己下载的那份（见下面的 CatLobbyDalamudDir）, 也可用环境变量 DALAMUD_HOME 指定。
  Protocol 目录是不依赖 Dalamud 的纯协议层, XIVLauncher.Test 按文件链接进去测。
-->
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
    <PropertyGroup>
        <AssemblyName>CatLobby</AssemblyName>
        <RootNamespace>XIVLauncher.CatLobby</RootNamespace>
        <Authors>Cat</Authors>
        <Version>0.1.0</Version>
        <ImplicitUsings>enable</ImplicitUsings>
        <SatelliteResourceLanguages>none</SatelliteResourceLanguages>
        <CanUnloadAsync>true</CanUnloadAsync>
        <!-- 本仓库用 Directory.Packages.props 集中管理包版本, 这个工程的包版本由 Dalamud SDK 自己指定 -->
        <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
        <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    </PropertyGroup>

    <!-- SDK 默认到 %APPDATA%\XIVLauncher\addon\Hooks\dev 找国际服 Dalamud; DML 把它放在 XIVLauncherCN\international 下 -->
    <PropertyGroup>
        <CatLobbyDalamudDir>$(APPDATA)\XIVLauncherCN\international\addon\Hooks\15.0.3.9\</CatLobbyDalamudDir>
        <DalamudLibPath Condition="'$(DALAMUD_HOME)' == ''">$(CatLobbyDalamudDir)</DalamudLibPath>
        <AssemblySearchPaths>$(AssemblySearchPaths);$(DalamudLibPath)</AssemblySearchPaths>
    </PropertyGroup>
</Project>
